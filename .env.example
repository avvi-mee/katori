# ─── App (public, bundled into the client: EXPO_PUBLIC_* only) ───
# The Supabase anon key is public by design; RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_POSTHOG_KEY=phc_placeholder
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=https://placeholder@o0.ingest.sentry.io/0
EXPO_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
EXPO_PUBLIC_APP_ENV=development
# 1 = in-browser demo backend (no accounts needed; local only, never in CI/production)
EXPO_PUBLIC_DEMO=0

# ─── Edge Function secrets (set with `npx supabase secrets set`, NEVER in the app) ───
# Copy these into supabase/functions/.env for local function runs.
AI_PROVIDER=gemini                 # gemini | claude-haiku-5-5 | claude-sonnet-5-5
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash      # use the current free-tier vision model
ANTHROPIC_API_KEY=your-anthropic-key
FREE_SCANS_PER_DAY=1
PRO_SCANS_SOFT_CAP=30
FREE_TEXT_LOGS_PER_DAY=10
PRO_TEXT_LOGS_SOFT_CAP=100
PAYMENT_PROVIDER=razorpay          # razorpay | dodo
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_PLAN_MONTHLY=plan_placeholder
RAZORPAY_PLAN_YEARLY=plan_placeholder
# Trainer plan: ₹99 per unit per month; quantity = active clients
RAZORPAY_PLAN_COACH=plan_placeholder
DODO_API_KEY=your-dodo-key
DODO_WEBHOOK_SECRET=whsec_placeholder
DODO_PRODUCT_MONTHLY=pdt_placeholder
DODO_PRODUCT_YEARLY=pdt_placeholder
DODO_PRODUCT_COACH=pdt_placeholder
DODO_ENVIRONMENT=test_mode         # test_mode | live_mode
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=long-random-string
SENTRY_DSN=https://placeholder@o0.ingest.sentry.io/0
APP_URL=https://katori.unmatrix.in

# ─── Local Supabase CLI only (hosted: set Google OAuth in the dashboard) ───
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-oauth-secret
